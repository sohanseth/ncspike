# Local-only env overrides stay ignored; the root .env (publishable values
# only) and .env.example are checked in.
.env.local
.env.*.local
!.env.example

# Wrangler / Cloudflare
.wrangler/
.dev.vars

# On-device NSFW classifier model — fetched at build time by
# scripts/fetch-android-nsfw-model.sh, never committed (binary, may be
# license-encumbered, swappable). See android/app/src/main/assets/README.md.
android/app/src/main/assets/nsfw_image_classifier.tflite


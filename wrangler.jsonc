{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tanstack-start-app",
  "compatibility_date": "2025-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/worker.ts",
  // 03:07 UTC nightly. Off-hour to dodge midnight cron storms; minute 7 to
  // avoid the global ":00" stampede on Cloudflare's scheduler.
  "triggers": {
    "crons": ["7 3 * * *"]
  }
}

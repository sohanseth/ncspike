{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tanstack-start-app",
  "compatibility_date": "2025-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/worker.ts",
  // Two scheduled triggers, dispatched by cron string in src/worker.ts:
  //
  //   "7 3 * * *"    — nightly research-cron. Off-hour + minute 7 to dodge
  //                    the midnight cron storm and the global ":00" stampede.
  //   "*/30 * * * *" — agent runtime batch tick (PR3c). Matches docs/16 §10
  //                    cadence; runAgentBatch caps at BATCH_LIMIT=10 agents
  //                    per tick and the lease TTL matches the interval, so
  //                    a missed tick is recovered by the stuck-run sweep on
  //                    the next one.
  "triggers": {
    "crons": ["7 3 * * *", "*/30 * * * *"]
  }
}

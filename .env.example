# Copy this file to .env.local and fill in real values.
#
# .env.local is gitignored; .env / .env.* are gitignored too. Do not
# commit a populated env file even if the keys look publishable —
# checked-in env files create habits that lead to real secret leaks.
#
# Values marked PUBLISHABLE are safe to share (used by the client / SSR
# bundle). Values marked SECRET must never leave a server context.

# ─── Supabase (PUBLISHABLE — VITE_* are inlined into the client bundle) ──
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Same values on the server side (server-fn middleware reads these too).
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# ─── Supabase service role (SECRET — server only) ───────────────────────
SUPABASE_SERVICE_ROLE_KEY=

# ─── OAuth (SECRET — server only) ───────────────────────────────────────
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ─── Inference providers (SECRET — server only) ─────────────────────────
GROQ_API_KEY=
GROQ_MODEL=
GOOGLE_AI_API_KEY=
GOOGLE_AI_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Cloudflare Workers (SECRET — used by wrangler + the worker runtime)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_AI_MODEL=

# Lovable lane (SECRET — only set if running Lovable's voice features locally)
LOVABLE_API_KEY=
LOVABLE_AI_MODEL=
